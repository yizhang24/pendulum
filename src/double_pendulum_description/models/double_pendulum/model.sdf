<sdf version="1.12">
  <model name="double_pendulum">
    <!-- Base -->
    <link name="slider">
      <pose>0.0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <pose>0 0 0 0 0 0</pose>
      </inertial>
      <visual name="vis_slider">
        <geometry>
          <box>
            <size>0.2 0.4 0.4</size>
          </box>
        </geometry>
      </visual>
    </link>

    <!-- Link 1 -->
    <link name="link1">
      <pose degrees="true">0.3 0 0 25.0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <pose>0 0 1.0 0 0 0</pose>
      </inertial>
      <visual name="vis_link">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>2.0</length>
          </cylinder>
        </geometry>
      </visual>
      <visual name="vis_upper_joint">
        <pose>-0.1 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="col_link">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>2.0</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
    <!-- Link 2 -->
    <!-- <link name="link2">
      <pose relative_to="link1" degrees="true">0.3 0.0 1.0 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <pose>0 0 1.0 0 0 0</pose>
      </inertial>
      <visual name="vis_link">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>2.0</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="col_link">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>1.8</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="vis_upper_joint">
        <pose>-0.15 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.5</length>
          </cylinder>
        </geometry>
      </visual>
    </link> -->

    <!-- Joint 0: world to slider -->
    <joint name="world_to_slider" type="prismatic">
      <parent>world</parent>
      <child>slider</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <!-- Move along the Z-axis -->
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-10.0</lower>
          <upper>10.0</upper>
        </limit>
        <dynamics>
          <damping>0.0</damping>
        </dynamics>
      </axis>
    </joint>
    <!-- Joint 1: slider to link 1 -->
    <joint name="slider_to_l1" type="revolute">
      <pose degrees="true">0 0 0 0 0 0</pose>
      <parent>slider</parent>
      <child>link1</child>
      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
      <use_parent_model_frame>1</use_parent_model_frame>
    </joint>
    <!-- <joint name="l1_to_2" type="revolute">
      <parent>link1</parent>
      <child>link2</child>
      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <damping>0.0</damping>
        </dynamics>
      </axis>
    </joint> -->
    <plugin
          filename="gz-sim-joint-state-publisher-system"
          name="gz::sim::systems::JointStatePublisher">
    </plugin>
    <plugin
      filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>world_to_slider</joint_name>
    </plugin>
  </model>
</sdf>
