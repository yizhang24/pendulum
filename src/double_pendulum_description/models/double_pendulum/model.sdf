<sdf version="1.12">
  <model name="double_pendulum">
    <!-- Link 1 -->
    <link name="link1">
      <pose degrees="true">0 0 2.0 80 0 0</pose>
      <inertial>
        <mass>1.0</mass>
          <pose>0 0 0.5 0 0 0</pose>
      </inertial>
      <visual name="link1_visual">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.9</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="link1_collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
    <!-- Link 2 -->
    <link name="link2">
      <pose relative_to="link1" degrees="true">0 0 1.0 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
          <pose>0 0 0.5 0 0 0</pose>
      </inertial>
      <visual name="link2_visual">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.9</length>
          </cylinder>
        </geometry>
      </visual>
    </link>
    <!-- Joint 1: world to link 1 -->
    <joint name="world_to_l1" type="revolute">
      <parent>world</parent>
      <child>link1</child>
      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <damping>0.0</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="l1_to_2" type="revolute">
      <parent>link1</parent>
      <child>link2</child>
      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <damping>0.0</damping>
        </dynamics>
      </axis>
    </joint>
  </model>
</sdf>
